<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>org.ueberbrot.mailctl-isolated</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/launchctl</string>
    <string>asuser</string>
    <string>__SERVICE_UID__</string>
    <string>/Library/PrivilegedHelperTools/org.ueberbrot.mailctl/mailctl-isolated</string>
  </array>
  <key>UserName</key>
  <string>__SERVICE_USER__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/var/db/mailctl-isolated</string>
    <key>PATH</key>
    <string>/usr/bin:/bin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>Umask</key>
  <integer>63</integer>
</dict>
</plist>
